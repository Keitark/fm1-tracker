{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:fm1-forge:project:1",
  "title":"FM1 Forge project ABI 1",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","project","profile","clockPreset","lcdPreset","module","usb"],
  "allOf":[{"if":{"properties":{"clockPreset":{"const":"sdk-320"}}},"then":{"properties":{"lcdPreset":{"const":"stock-dma"}}}}],
  "properties":{
    "schemaVersion":{"const":1},
    "project":{"type":"object","additionalProperties":false,"required":["slug","displayName"],"properties":{"slug":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,47}$"},"displayName":{"type":"string","minLength":1,"maxLength":64}}},
    "profile":{"const":"forge-diag"},
    "clockPreset":{"enum":["sdk-default","sdk-320"]},
    "lcdPreset":{"enum":["stock-dma","spi15-rgb444","spi30-rgb444"]},
    "module":{"enum":["diagnostics","user"]},
    "usb":{"type":"object","additionalProperties":false,"required":["cdc","uac","uboot"],"properties":{"cdc":{"const":true},"uac":{"type":"boolean","default":true},"uboot":{"const":true}}}
  }
}
